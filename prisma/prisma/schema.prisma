datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}



model Rol {
  id        Int       @id @default(autoincrement())
  nombre    String    @unique
  usuarios  Usuario[]

  createdAt DateTime  @default(now())
}

model Usuario {
  id         Int      @id @default(autoincrement())
  nombre     String
  apellido   String
  email      String   @unique
  password   String

  activo     Boolean  @default(true)

  rolId      Int
  rol        Rol      @relation(fields: [rolId], references: [id])

  createdAt  DateTime @default(now())
}